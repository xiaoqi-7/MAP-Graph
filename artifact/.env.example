LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=replace_with_your_llm_api_key
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_MODEL_FAMILY=qwen
BACKBONE_ID=qwen25_7b
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
LLM_MAX_RETRIES=5
LLM_RETRY_BACKOFF_SECONDS=3
# Optional: set these to the provider's current USD prices to estimate API cost.
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
# Keep false for the first run so sentence-transformers can download the model.
# After it is cached locally, true enables fully offline embedding startup.
EMBEDDING_LOCAL_FILES_ONLY=false

# Reported B3/G-Memory adaptation: deterministic trajectory sparsification and
# similarity reranking, with periodic LLM insight updates only.
GMEMORY_STRICT_LLM=false
GMEMORY_INSIGHT_LLM=true
GMEMORY_MAX_GRAPH_TASKS=512
GMEMORY_START_INSIGHTS_THRESHOLD=5
GMEMORY_ROUNDS_PER_INSIGHTS=5
GMEMORY_INSIGHTS_POINT_NUM=5

SOPHON_API_BASE_URL=https://sophon-api.vzoom.com/ai/v1
SOPHON_API_KEY=replace_with_your_sophon_api_key
SOPHON_MODEL=qwen-core
SOPHON_VERIFY_SSL=true
SOPHON_MAX_RETRIES=2
SOPHON_RETRY_DELAY_SECONDS=1.5
SOPHON_MAX_FAILURES=3
SOPHON_TEMPERATURE=0.75
SOPHON_MAX_TOKENS=1800
SOPHON_TRUST_ENV=false
